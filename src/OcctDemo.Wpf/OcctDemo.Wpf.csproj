<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">..\..\assets\icons\occt-demo.ico</ApplicationIcon>
    <AssemblyName>CAD-WPF</AssemblyName>
    <RootNamespace>OcctDemo.Wpf</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OcctDemo.Common\OcctDemo.Common.csproj" />
    <Reference Include="OcctNet">
      <HintPath>$(OcctBridgeDistRoot)\OcctNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OcctNet.Wpf">
      <HintPath>$(OcctBridgeDistRoot)\OcctNet.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
