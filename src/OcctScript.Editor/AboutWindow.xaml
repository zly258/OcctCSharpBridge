<Window x:Class="OcctScript.Editor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.About}"
        Width="470" Height="330"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Margin="16" Style="{StaticResource PanelBorderStyle}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource About.Product}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,12">
                <TextBlock Text="{DynamicResource About.VersionLabel}" FontWeight="SemiBold" />
                <TextBlock Text=" · " />
                <TextBlock Text="{DynamicResource About.Version}" />
            </StackPanel>
            <Border Grid.Row="2" Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,14" />
            <StackPanel Grid.Row="3">
                <TextBlock Text="{DynamicResource About.Description}" TextWrapping="Wrap" Margin="0,0,0,14" />
                <TextBlock Text="{DynamicResource About.Technology}" Margin="0,0,0,5" />
                <TextBlock Text="{DynamicResource About.Bridge}" Margin="0,0,0,5" />
                <TextBlock Text="{DynamicResource About.Repository}" Foreground="{StaticResource Brush.Muted}" />
            </StackPanel>
            <Button Grid.Row="4" Content="{DynamicResource Ui.Close}" Width="88" HorizontalAlignment="Right" IsDefault="True" Click="Close_Click" />
        </Grid>
    </Border>
</Window>
