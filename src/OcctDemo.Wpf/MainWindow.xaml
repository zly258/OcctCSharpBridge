<Window x:Class="OcctDemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:occt="clr-namespace:OcctNet;assembly=OcctNet.Wpf"
        mc:Ignorable="d"
        Title="OCCT CAD - WPF"
        Height="850" Width="1450"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#EEF1F4"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#F5F6F7"/>
            <Setter Property="BorderBrush" Value="#C7CDD3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="#E7EAED"/>
            <Setter Property="BorderBrush" Value="#C7CDD3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#AEB6BE"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderBrush" Value="#B8C0C8"/>
            <Setter Property="Background" Value="#F8F9FA"/>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD1D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="#2F3B46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4,1"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top"/>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="#E7EAED">
            <ToolBar x:Name="MainToolBar" Band="0" BandIndex="0"/>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="CommandStatus" Text="Initializing..." MinWidth="320"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="SelectionStatus" Text="No selection" MinWidth="170"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CoordinateStatus" Text="X 0.000  Y 0.000  Z 0.000" FontFamily="Consolas"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="420"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="160" MinHeight="110"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="220"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="520"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="330" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <GroupBox x:Name="ModelExplorerGroup" Grid.Column="0" Header="Model Explorer">
                    <TreeView x:Name="ObjectTree"/>
                </GroupBox>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#C7CDD3"/>

                <Border Grid.Column="2" Margin="4" BorderBrush="#AEB6BE" BorderThickness="1" Background="#E8EDF2">
                    <occt:OcctWpfViewport x:Name="Viewport"
                                          EnableRectangleSelection="True"
                                          RectangleSelectionThreshold="5"
                                          SynchronizeRenderDpi="True"/>
                </Border>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#C7CDD3"/>

                <GroupBox x:Name="PropertiesGroup" Grid.Column="4" Header="Properties">
                    <DataGrid x:Name="PropertyGrid"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              BorderBrush="#CBD1D6"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="PropertyNameColumn" Header="Property" Binding="{Binding Key}" Width="2*" MinWidth="95"/>
                            <DataGridTextColumn x:Name="PropertyValueColumn" Header="Value" Binding="{Binding Value}" Width="3*" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          Background="#C7CDD3"/>

            <GroupBox x:Name="CommandLineGroup" Header="Command Line" Grid.Row="2">
                <TextBox x:Name="LogBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="White"
                         Foreground="#20262C"
                         BorderBrush="#CBD1D6"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
