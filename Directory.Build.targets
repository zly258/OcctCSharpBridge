<Project>
  <Target Name="ValidateOcctBridgeBinarySdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(OcctBridgeDistRoot)\OcctNet.dll')" Text="Bridge Binary SDK is missing. Sync dist/win-x64 from main after running dist.ps1." />
    <Error Condition="!Exists('$(OcctBridgeDistRoot)\OcctNative.dll')" Text="OcctNative.dll is missing from dist/win-x64." />
    <Error Condition="!Exists('$(OcctBridgeDistRoot)\bridge-contract.json')" Text="bridge-contract.json is missing from dist/win-x64." />
    <Error Condition="!Exists('$(OcctBridgeDistRoot)\bridge-manifest.json')" Text="bridge-manifest.json is missing from dist/win-x64." />
  </Target>

  <Target Name="CopyOcctNativeBridge"
          AfterTargets="Build"
          Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <Copy SourceFiles="$(OcctBridgeDistRoot)\OcctNative.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
