<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>7</WarningLevel>
    <Authors>zly258</Authors>
    <Company>zly258</Company>
    <Product>OcctCSharpBridge Demo</Product>
    <Description>Unified WinForms, WPF and Avalonia consumers for the OcctCSharpBridge Binary SDK.</Description>
    <OcctBridgeRuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</OcctBridgeRuntimeIdentifier>
    <OcctBridgeRuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</OcctBridgeRuntimeIdentifier>
    <OcctBridgeDistRoot>$(MSBuildThisFileDirectory)dist/$(OcctBridgeRuntimeIdentifier)</OcctBridgeDistRoot>
  </PropertyGroup>
</Project>
