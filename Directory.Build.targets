<Project>
  <PropertyGroup>
    <OcctBridgeNativeLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">OcctNative.dll</OcctBridgeNativeLibrary>
    <OcctBridgeNativeLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">libOcctNative.so</OcctBridgeNativeLibrary>
    <OcctBridgeIsDemoProject Condition="'$(MSBuildProjectName)' == 'OcctDemo.Common' or '$(MSBuildProjectName)' == 'OcctDemo.WinForms' or '$(MSBuildProjectName)' == 'OcctDemo.Wpf' or '$(MSBuildProjectName)' == 'OcctDemo.Avalonia'">true</OcctBridgeIsDemoProject>
  </PropertyGroup>

  <Target Name="ValidateOcctBridgeBinarySdk"
          BeforeTargets="ResolveReferences"
          Condition="'$(OcctBridgeIsDemoProject)' == 'true'">
    <Error Condition="'$(OcctBridgeRuntimeIdentifier)' == ''" Text="OcctCSharpBridge Demo supports Windows x64 and Linux x64 only." />
    <Error Condition="!Exists('$(OcctBridgeDistRoot)/$(OcctBridgeNativeLibrary)')" Text="The $(OcctBridgeRuntimeIdentifier) native Bridge is missing. Run the platform sync script first." />
    <Error Condition="!Exists('$(OcctBridgeDistRoot)/OcctNet.dll')" Text="OcctNet.dll is missing from the synchronized Binary SDK." />
    <Error Condition="'$(MSBuildProjectName)' == 'OcctDemo.WinForms' and !Exists('$(OcctBridgeDistRoot)/OcctNet.WinForms.dll')" Text="OcctNet.WinForms.dll is missing from the synchronized Binary SDK." />
    <Error Condition="'$(MSBuildProjectName)' == 'OcctDemo.Wpf' and !Exists('$(OcctBridgeDistRoot)/OcctNet.Wpf.dll')" Text="OcctNet.Wpf.dll is missing from the synchronized Binary SDK." />
    <Error Condition="'$(MSBuildProjectName)' == 'OcctDemo.Avalonia' and !Exists('$(OcctBridgeDistRoot)/OcctNet.Avalonia.dll')" Text="OcctNet.Avalonia.dll is missing from the synchronized Binary SDK." />
    <Error Condition="!Exists('$(OcctBridgeDistRoot)/bridge-contract.json')" Text="bridge-contract.json is missing from the synchronized Binary SDK." />
    <Error Condition="!Exists('$(OcctBridgeDistRoot)/bridge-manifest.json')" Text="bridge-manifest.json is missing from the synchronized Binary SDK." />
  </Target>

  <Target Name="CopyOcctNativeBridge"
          AfterTargets="Build"
          Condition="'$(OcctBridgeIsDemoProject)' == 'true' and ('$(OutputType)' == 'WinExe' or '$(OutputType)' == 'Exe')">
    <Copy SourceFiles="$(OcctBridgeDistRoot)/$(OcctBridgeNativeLibrary)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="VerifyWindowsSelfContainedPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(SelfContained)' == 'true' and '$(OutputType)' == 'WinExe'">
    <PropertyGroup>
      <_PublishedRuntimeConfig>$(PublishDir)$(AssemblyName).runtimeconfig.json</_PublishedRuntimeConfig>
    </PropertyGroup>

    <Error Condition="!Exists('$(PublishDir)$(AssemblyName).exe')"
           Text="Self-contained publish gate failed: $(AssemblyName).exe is missing from $(PublishDir)." />
    <Error Condition="!Exists('$(_PublishedRuntimeConfig)')"
           Text="Self-contained publish gate failed: $(AssemblyName).runtimeconfig.json is missing from $(PublishDir)." />
    <Error Condition="!Exists('$(PublishDir)hostfxr.dll')"
           Text="Self-contained publish gate failed: hostfxr.dll is missing from $(PublishDir). The package would require an installed .NET runtime." />
    <Error Condition="!Exists('$(PublishDir)hostpolicy.dll')"
           Text="Self-contained publish gate failed: hostpolicy.dll is missing from $(PublishDir)." />
    <Error Condition="!Exists('$(PublishDir)coreclr.dll')"
           Text="Self-contained publish gate failed: coreclr.dll is missing from $(PublishDir)." />
    <Error Condition="!Exists('$(PublishDir)System.Private.CoreLib.dll')"
           Text="Self-contained publish gate failed: System.Private.CoreLib.dll is missing from $(PublishDir)." />

    <Message Importance="high"
             Text="[self-contained-gate] $(AssemblyName): local .NET runtime payload verified in $(PublishDir)." />
  </Target>

  <Target Name="VerifyLinuxSelfContainedPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' and '$(SelfContained)' == 'true' and '$(OutputType)' == 'Exe'">
    <PropertyGroup>
      <_PublishedRuntimeConfig>$(PublishDir)$(AssemblyName).runtimeconfig.json</_PublishedRuntimeConfig>
    </PropertyGroup>

    <Error Condition="!Exists('$(PublishDir)$(AssemblyName)')"
           Text="Self-contained publish gate failed: $(AssemblyName) binary is missing from $(PublishDir)." />
    <Error Condition="!Exists('$(_PublishedRuntimeConfig)')"
           Text="Self-contained publish gate failed: $(AssemblyName).runtimeconfig.json is missing from $(PublishDir)." />
    <Error Condition="!Exists('$(PublishDir)libhostfxr.so')"
           Text="Self-contained publish gate failed: libhostfxr.so is missing from $(PublishDir). The package would require an installed .NET runtime." />
    <Error Condition="!Exists('$(PublishDir)libhostpolicy.so')"
           Text="Self-contained publish gate failed: libhostpolicy.so is missing from $(PublishDir)." />
    <Error Condition="!Exists('$(PublishDir)libcoreclr.so')"
           Text="Self-contained publish gate failed: libcoreclr.so is missing from $(PublishDir)." />
    <Error Condition="!Exists('$(PublishDir)System.Private.CoreLib.dll')"
           Text="Self-contained publish gate failed: System.Private.CoreLib.dll is missing from $(PublishDir)." />

    <Message Importance="high"
             Text="[self-contained-gate] $(AssemblyName): local Linux .NET runtime payload verified in $(PublishDir)." />
  </Target>
</Project>
